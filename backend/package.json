{
  "name": "sigevac-backend",
  "version": "1.0.0",
  "description": "SIGEVAC - Sistema Integral para la Gestión de Expedientes y Voluntariado para Asociaciones Civiles (API REST)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node database/setup.js",
    "db:seed": "node database/seeds/run.js",
    "db:seed:demo": "node database/seeds/002_seed_demo.js",
    "db:seed:inventario": "node database/seeds/003_seed_inventario_demo.js",
    "db:seed:galeria": "node database/seeds/004_seed_galeria.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "lint": "eslint .",
    "db:restore": "node scripts/restaurar-respaldo.js",
    "db:verify-restore": "node scripts/verificar-restauracion.js",
    "smoke": "node scripts/smoke-test.js",
    "db:encrypt-existing": "node scripts/cifrar-datos-existentes.js",
    "db:scrub-audit": "node scripts/depurar-auditoria.js",
    "db:migrate-2fa-key": "node scripts/migrar-llave-2fa.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.1.0",
    "file-type": "^22.0.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  }
}
