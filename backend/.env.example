# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/sigevac
DB_SSL=false

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_esto_tambien_por_otro_secreto
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad / fuerza bruta
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15

# CORS
FRONTEND_URL=http://localhost:5173

# Correo (para recuperación de contraseña y notificaciones - Módulo 17)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGEVAC <no-reply@suenosdecomedia.org>"

# Super admin inicial (usado solo por database/seeds/run.js)
# IMPORTANTE: si la contraseña incluye "#" o espacios, ponla entre comillas dobles;
# dotenv interpreta "#" como inicio de comentario incluso sin espacio previo.
SEED_ADMIN_EMAIL=admin@suenosdecomedia.org
SEED_ADMIN_PASSWORD="Sigevac#2026"
