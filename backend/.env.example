# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/sigevac
DB_SSL=false

# JWT
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERA_OTRO_SECRETO_ALEATORIO_LARGO
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad / fuerza bruta
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15

# CORS
FRONTEND_URL=http://localhost:5173

# Almacenamiento persistente (obligatorio en producción)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=sigevac-files

# Correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGEVAC <no-reply@suenosdecomedia.org>"

# WhatsApp Cloud API (opcional; requiere número y plantillas aprobadas en Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Vigencia de documentos
DIAS_ALERTA_VIGENCIA=30
DESACTIVAR_CRON_VIGENCIA=true

# Super admin inicial
SEED_ADMIN_EMAIL=admin@suenosdecomedia.org
SEED_ADMIN_PASSWORD="CAMBIA_ESTA_PASSWORD_SEGURA"