# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/sigevac
DB_SSL=false

# JWT
JWT_SECRET=super_secreto_desarrollo_sigevac_2026_key_123
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_refresh_secreto_desarrollo_sigevac_2026_key_456
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad / fuerza bruta
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15

# CORS
FRONTEND_URL=http://localhost:5173

# Correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGEVAC <no-reply@suenosdecomedia.org>"

# Almacenamiento de archivos (documentos, fotos de galería, respaldos)
# ------------------------------------------------------------------
# Si se dejan vacías, los archivos se guardan en el disco local
# (backend/uploads/). Eso funciona perfecto en desarrollo, pero en
# Render (y la mayoría de plataformas gratuitas) el disco NO es
# persistente: se borra en cada reinicio/redeploy/hibernación, y las
# fotos/documentos ya subidos dejan de cargar sin que nada en el código
# haya cambiado. Por eso app.js EXIGE estas tres variables cuando
# NODE_ENV=production o cuando detecta que corre en Render — para que
# el error se note al desplegar, no semanas después con archivos
# perdidos. Ver DEPLOY.md, sección "Almacenamiento de archivos".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sigevac-files

# WhatsApp Business Cloud API (Meta) — opcional
# ---------------------------------------------
# Si se deja vacío, el sistema sigue funcionando y solo envía correo.
# IMPORTANTE: Meta solo acepta texto libre dentro de la ventana de 24 h
# que abre el usuario al escribir primero. Todas las notificaciones de
# SIGEVAC las inicia la asociación, así que DEBEN enviarse como plantilla
# aprobada; sin WHATSAPP_TEMPLATE_NOTIFICACION no se envía nada (Meta las
# rechazaría con el error 131047). Ver DEPLOY.md, sección "WhatsApp".
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nombre exacto de la plantilla aprobada en el WhatsApp Manager.
# Debe tener una sola variable {{1}} en el cuerpo, que recibe el texto
# de la notificación.
WHATSAPP_TEMPLATE_NOTIFICACION=
WHATSAPP_TEMPLATE_IDIOMA=es_MX
# Código de país que se antepone a los teléfonos locales de 10 dígitos.
WHATSAPP_CODIGO_PAIS=52

# Geocodificación (buscador de lugares del formulario de actividades)
# ------------------------------------------------------------------
# La política de uso de Nominatim exige un User-Agent que identifique a
# la aplicación con un contacto real (URL o correo que resuelva); si no,
# bloquea las peticiones con 403. Cámbialo por el contacto de tu
# despliegue. El backend ya respeta el límite de 1 req/s y cachea.
NOMINATIM_USER_AGENT="SIGEVAC/1.0 (+https://github.com/Pedros178/SIGEVAC)"
# Opcional: apunta a una instancia propia de Nominatim o a otro proveedor.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Países a los que se limitan las búsquedas (códigos ISO separados por coma).
NOMINATIM_PAISES=mx

# Vigencia de documentos
DIAS_ALERTA_VIGENCIA=30
DESACTIVAR_CRON_VIGENCIA=true

# Página pública de inicio: de qué asociación mostrar "Actividades próximas".
# Opcional — si no se define, se usa la asociación más antigua (la del seed).
ASOCIACION_PUBLICA_ID=

# Super admin inicial
SEED_ADMIN_EMAIL=admin@suenosdecomedia.org
SEED_ADMIN_PASSWORD="Sigevac#2026"