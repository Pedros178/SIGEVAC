# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/sigevac
DB_SSL=false

# JWT
JWT_SECRET=super_secreto_desarrollo_sigevac_2026_key_123
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_refresh_secreto_desarrollo_sigevac_2026_key_456
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad / fuerza bruta
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15

# CORS
FRONTEND_URL=http://localhost:5173

# Correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGEVAC <no-reply@suenosdecomedia.org>"

# Almacenamiento de archivos (documentos, fotos de galería, respaldos)
# ------------------------------------------------------------------
# Si se dejan vacías, los archivos se guardan en el disco local
# (backend/uploads/). Eso funciona perfecto en desarrollo, pero en
# Render (y la mayoría de plataformas gratuitas) el disco NO es
# persistente: se borra en cada reinicio/redeploy/hibernación, y las
# fotos/documentos ya subidos dejan de cargar sin que nada en el código
# haya cambiado. Por eso app.js EXIGE estas tres variables cuando
# NODE_ENV=production o cuando detecta que corre en Render — para que
# el error se note al desplegar, no semanas después con archivos
# perdidos. Ver DEPLOY.md, sección "Almacenamiento de archivos".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sigevac-files

# Vigencia de documentos
DIAS_ALERTA_VIGENCIA=30
DESACTIVAR_CRON_VIGENCIA=true

# Página pública de inicio: de qué asociación mostrar "Actividades próximas".
# Opcional — si no se define, se usa la asociación más antigua (la del seed).
ASOCIACION_PUBLICA_ID=

# Super admin inicial
SEED_ADMIN_EMAIL=admin@suenosdecomedia.org
SEED_ADMIN_PASSWORD="Sigevac#2026"